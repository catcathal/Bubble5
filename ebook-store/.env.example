# Get these from the Stripe Dashboard (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Get these from Google Cloud Console (APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of your site (used for redirects)
BASE_URL=http://localhost:4242

# Any long random string
SESSION_SECRET=
